<resources>
    <style name="Theme.BlueNet" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bn_primary</item>
        <item name="colorPrimaryDark">@color/bn_background</item>
        <item name="colorAccent">@color/bn_primary</item>
        <item name="colorControlActivated">@color/bn_primary</item>
        <item name="android:windowBackground">@color/bn_background</item>
        <item name="android:statusBarColor">@color/bn_background</item>
        <item name="android:navigationBarColor">@color/bn_background</item>
        <item name="android:textColorPrimary">@color/bn_on_surface</item>
        <item name="android:textColorSecondary">@color/bn_on_surface_variant</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.BlueNet.Dialog</item>
    </style>

    <style name="ThemeOverlay.BlueNet.Dialog" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/bn_primary</item>
        <item name="android:background">@color/bn_surface</item>
    </style>

    <style name="TextAppearance.BlueNet.Title" parent="TextAppearance.AppCompat">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bn_on_surface</item>
    </style>

    <style name="TextAppearance.BlueNet.Section" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/bn_on_surface_variant</item>
    </style>

    <style name="TextAppearance.BlueNet.Body" parent="TextAppearance.AppCompat">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/bn_on_surface</item>
    </style>

    <style name="TextAppearance.BlueNet.Caption" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/bn_on_surface_variant</item>
    </style>

    <style name="Widget.BlueNet.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.BlueNet.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/bn_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.BlueNet.Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/bn_on_primary_container</item>
    </style>

    <style name="Widget.BlueNet.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bn_on_surface_variant</item>
    </style>
</resources>
