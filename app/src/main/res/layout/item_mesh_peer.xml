<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPeer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp"
    style="?attr/materialCardViewOutlinedStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivPeerIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_status_chip"
            android:backgroundTint="?attr/colorPrimaryContainer"
            android:padding="12dp"
            android:src="@drawable/ic_bluetooth_client"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPeerInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSharing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chip_sharing"
                android:visibility="gone"
                android:layout_marginTop="4dp"
                app:chipMinHeight="24dp"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipBackgroundColor="?attr/colorPrimaryContainer"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConnectPeer"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_connect"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
