<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bn_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.BlueNet.Title" />

            <TextView
                android:id="@+id/identityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.BlueNet.Caption"
                tools:text="You are Wal · ID 3fa9c1" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/editNameButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_name"
            android:src="@drawable/ic_edit"
            android:tint="@color/bn_on_surface_variant" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusChip"
        style="@style/Widget.BlueNet.Chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        tools:text="Mesh active · 3 nearby · 1 linked" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <!-- Shown when Bluetooth is off or permissions are missing. -->
            <LinearLayout
                android:id="@+id/bannerCard"
                style="@style/Widget.BlueNet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/bannerText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.BlueNet.Body"
                    tools:text="@string/permission_rationale" />

                <Button
                    android:id="@+id/bannerButton"
                    style="@style/Widget.BlueNet.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="@string/grant" />
            </LinearLayout>

            <!-- Our own use of a peer's internet. -->
            <LinearLayout
                android:id="@+id/tunnelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_primary"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tunnel_title"
                    android:textAppearance="@style/TextAppearance.BlueNet.Section"
                    android:textColor="@color/bn_on_primary_container" />

                <TextView
                    android:id="@+id/tunnelStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.BlueNet.Body"
                    android:textColor="@color/bn_on_primary_container"
                    android:textStyle="bold"
                    tools:text="Connected through Wal's phone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tunnelStatsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.BlueNet.Caption"
                        android:textColor="@color/bn_on_primary_container"
                        tools:text="▲ 1.2 MB   ▼ 8.4 MB   12 flows" />

                    <Button
                        android:id="@+id/disconnectButton"
                        style="@style/Widget.BlueNet.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/disconnect" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sharing our internet. -->
            <LinearLayout
                android:id="@+id/shareCard"
                style="@style/Widget.BlueNet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_bluetooth_host"
                    android:tint="@color/bn_on_primary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/share_title"
                        android:textAppearance="@style/TextAppearance.BlueNet.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/shareSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/share_subtitle"
                        android:textAppearance="@style/TextAppearance.BlueNet.Caption" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/shareSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="12dp"
                android:text="@string/nearby_title"
                android:textAppearance="@style/TextAppearance.BlueNet.Section" />

            <LinearLayout
                android:id="@+id/broadcastRow"
                style="@style/Widget.BlueNet.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_avatar"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_forum"
                    android:tint="@color/bn_on_primary_container" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/broadcast_chat"
                        android:textAppearance="@style/TextAppearance.BlueNet.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/broadcast_chat_subtitle"
                        android:textAppearance="@style/TextAppearance.BlueNet.Caption" />
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/peerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_peer" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:text="@string/no_peers"
                android:textAppearance="@style/TextAppearance.BlueNet.Caption" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
